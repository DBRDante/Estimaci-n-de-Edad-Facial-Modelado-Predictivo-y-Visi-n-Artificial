    "# Definir rutas\n",
    "\n",
    "\n",
    "data_path = \"\"  \n",
    "images_path = \"final_files/\"\n",
    "\n",
    "\n",
    "# Cargar datos\n",
    "\n",
    "\n",
    "labels = pd.read_csv(data_path + 'labels.csv')\n",
    "\n",
    "\n",
    "\n",
    "# Dividir en entrenamiento y validación\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "train_dataframe, validation_dataframe = train_test_split(\n",
    "    labels,\n",
    "    test_size=0.25,\n",
    "    random_state=12345)\n",
    "\n",
    "\n",
    "# Crear generadores\n",
    "train_data_flow = load_train(train_dataframe, images_path)\n",
    "validation_data_flow = load_test(validation_dataframe, images_path)\n",
    "\n",
    "\n",
    "\n",
    "#  Crear modelo\n",
    "\n",
    "model = create_model((224, 224, 3))\n",
    "\n",
    "\n",
    "# Entrenar modelo\n",
    "\n",
    "model = train_model(\n",
    "    model,\n",
    "    train_data_flow,\n",
    "    validation_data_flow,\n",
    "    epochs=20)"
   ]
