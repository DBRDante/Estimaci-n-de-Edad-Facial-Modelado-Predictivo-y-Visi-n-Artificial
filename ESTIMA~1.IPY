    }
   ],
   "source": [
    "plt.figure(figsize=(15,10))\n",
    "\n",
    "for i, age in enumerate(unique_ages):\n",
    "    # Obtenemos la primera imagen con esa edad\n",
    "    sample_row = labels_dataframe[labels_dataframe['real_age'] == age].iloc[0]\n",
