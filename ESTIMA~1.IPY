    "# 1. Instanciación del pipeline determinista de validación\n",
    "validation_data_flow = load_test(validation_dataframe, images_path)\n",
    "\n",
    "# 2. Recuperación del artefacto óptimo persistido en disco\n",
    "print(\"\\n--- Cargando el artefacto optimizado 'best_model.h5' ---\")\n",
    "model = tf.keras.models.load_model('best_model.h5')\n",
    "\n",
    "# 3. Ejecución de la fase de evaluación métrica\n",
    "print(\"\\n--- Evaluando el rendimiento generalizado del modelo ---\")\n",
    "loss, mae = model.evaluate(validation_data_flow)\n",
    "print(f\"Error Absoluto Medio (MAE) final sobre validación: {mae:.4f} años\")\n",
    "\n",
    "# 4. Inferencia por lotes para el contraste empírico de predicciones\n",
    "predictions = model.predict(validation_data_flow, steps=1)\n",
    "real_ages = validation_dataframe['real_age'].values[:len(predictions)]\n",
    "\n",
    "print(\"\\n--- Análisis Comparativo: Valor Real vs. Estimación Neuronal ---\")\n",
    "for i in range(5):\n",
    "    print(f\"Instancia {i+1} -> Edad Real: {real_ages[i]} | Edad Estimada: {predictions[i][0]:.1f}\")"
